# ============================================================
#  BEM FST UNSAM -- SUIC 2026 / IDC Registration Website
#  Environment Configuration Template
#
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
#  This file (.env.example) is safe to commit -- it contains
#  only placeholder values, never real secrets.
# ============================================================

# -- Application ----------------------------------------------
# Environment: "production" | "development"
APP_ENV=production

# Show detailed errors (set false in production)
APP_DEBUG=false

# Public-facing base URL (no trailing slash)
APP_URL=https://your-domain.com

# -- Database (MySQL / MariaDB) --------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bem_fst_unsam
DB_USER=your_database_user_here
DB_PASSWORD=your_database_password_here

# -- SUIC 2026 WhatsApp Contact --------------------------------
# Official WhatsApp number for the SUIC 2026 committee.
# Format: international digits without "+", e.g. 6281377178981
# This is used to build wa.me click-to-chat links only.
# It is NOT a WhatsApp Business API credential.
SUIC_WA_COMMITTEE_NUMBER=6281377178981

# -- Session Security ------------------------------------------
# Optional: custom PHP session name (leave blank to use default)
# SESSION_NAME=bem_sess

# -- File Upload Limits ----------------------------------------
# Optional: override maximum upload size in bytes (default: 10 MB)
# UPLOAD_MAX_BYTES=10485760
